# PostgreSQL connection string (provided by Railway automatically)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Secret key for signing JWTs — generate a long random string
# You can generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Node environment
NODE_ENV=production

# Port (Railway sets this automatically — don't change)
PORT=3000

# --- EMAIL (optional but recommended) ---
# Sign up free at https://resend.com to get an API key
# Free tier: 100 emails/day, 3,000/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" address for notification emails
# Free tier: use "onboarding@resend.dev" OR verify your own domain
FROM_EMAIL=PO System <onboarding@resend.dev>

# Customer-facing quote email. Both are OPTIONAL and fall back to FROM_EMAIL and
# the preparer's own address, so leaving them blank changes nothing. Set them
# when quotes should come from a customer-friendly sender rather than the same
# address every internal Nova notification uses.
#   QUOTE_FROM_EMAIL - the sender a customer sees, e.g. Lock and Roll <quotes@lockandroll.com>
#   QUOTE_REPLY_TO   - where a reply lands. Unset = the person who wrote the quote.
QUOTE_FROM_EMAIL=
QUOTE_REPLY_TO=

# --- DOCUMENT VAULT STORAGE (Cloudflare R2) ---
# Create a free R2 bucket at https://dash.cloudflare.com (R2 > Create bucket),
# then create an R2 API token (R2 > Manage R2 API Tokens > Create, Object Read & Write).
# R2_ACCOUNT_ID is the long ID in your R2 endpoint URL on the R2 overview page.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=nova-documents

# --- PTT RADIO (LiveKit) ---
# Create a free project at https://cloud.livekit.io, then copy the values
# from Settings > Keys. URL looks like wss://your-project-xxxxxxx.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- OUTLOOK ADD-IN SSO (passwordless "Send to Nova" sign-in) ---
# Register an app in Entra/Azure AD, expose an API with App ID URI
# api://www.popalockar.com/<client-id> and a scope "access_as_user", then:
ADDIN_SSO_CLIENT_ID=your-entra-app-client-id
# Optional overrides (sensible defaults are derived if omitted):
# ADDIN_SSO_APP_ID_URI defaults to api://www.popalockar.com/<ADDIN_SSO_CLIENT_ID>
ADDIN_SSO_APP_ID_URI=api://www.popalockar.com/your-entra-app-client-id
# ADDIN_SSO_TENANT_ID pins the tenant; if omitted, the tenant from the token is used.
ADDIN_SSO_TENANT_ID=your-azure-tenant-id

# --- NOVA VOICE (Hey Nova) ---
# ONE vendor powers both ears and voice: ElevenLabs (STT via Scribe + TTS).
# Get a key at https://elevenlabs.io (Profile > API Keys).
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Voice to speak in. Copy an ID from ElevenLabs > Voices (default is the "Rachel" preset).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional TTS model override (default eleven_turbo_v2_5 for low latency)
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Optional STT model override (default scribe_v2; scribe_v1 also valid)
ELEVENLABS_STT_MODEL=scribe_v2

# --- AI ASSISTANT (Nova AI / Neurolock) ---
# Anthropic API key — powers AI chat, agent actions, review matching, feedback triage, quiz gen.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Optional per-user AI usage caps (number of calls). Omit both for no cap.
AI_DAILY_LIMIT=
AI_MONTHLY_LIMIT=

# --- PUBLIC APP URL ---
# Base URL of this deployment. Used to build links in emails/SMS and OAuth/MCP metadata.
APP_URL=https://your-app.up.railway.app

# --- SMS 2FA + late-clock-in texts (Twilio) ---
# From the Twilio console. FROM_NUMBER must be an SMS-capable number you own.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- Check-in / check-out calls (optional) ---------------------------------
# Nova calls an account's check-in line on the technician's behalf and only
# marks the job when the phone tree confirms it out loud.
#
# NOTHING HERE IS REQUIRED to get started: voice falls back to
# TWILIO_FROM_NUMBER and the callbacks fall back to APP_URL. Set these when you
# want to separate the two.
#
# A dedicated voice number, so check-in calls cannot die with the number that
# sends two-factor texts. Must be voice-capable.
TWILIO_VOICE_FROM_NUMBER=
# The public base Twilio calls back on. Defaults to APP_URL. Set it explicitly
# if a proxy ever rewrites the scheme, because the webhook signature is checked
# against the exact URL and a mismatch is a silent 403 on every callback.
TWILIO_WEBHOOK_BASE=
# An API key pair for downloading call recordings. Recording media URLs enforce
# HTTP Basic auth; without these Nova falls back to the account auth token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Hard ceiling on a single call, in seconds. Default 180. A phone tree stuck in
# a loop must not bill forever.
CHECKIN_MAX_CALL_SECONDS=180
# How long to keep call audio in R2. Transcripts are kept regardless, because
# they are what the system reads. 0 or unset keeps the audio forever.
CHECKIN_RECORDING_RETENTION_DAYS=365
# The model that decides each keypress when an account is on the AI navigator.
# Unset uses the same model the work order parser already runs on, so a first
# deploy cannot fail on a model name. The reason to change it is LATENCY: every
# turn is the phone tree waiting while Nova thinks, and a smaller model shaves a
# second or two off each one.
CHECKIN_AI_MODEL=
# The navigator also needs ANTHROPIC_API_KEY (already set for the AI assistant
# and the work order parser) and, for accounts whose PIN is issued to the company
# rather than printed on each work order, HR_DOC_ENC_KEY below - a vendor PIN is
# a credential and Nova will refuse to store one in the clear.

# --- WEB / DESKTOP PUSH (VAPID) ---
# Generate a key pair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI required by the push spec (mailto: or https:).
VAPID_SUBJECT=mailto:admin@popalockar.com

# --- SECURE HR DOCUMENTS (onboarding: SSN / DL / I-9 / W-4) ---
# 32-byte hex key for AES-256-GCM encryption of collected HR docs.
# Generate with:  openssl rand -hex 32   (do NOT rotate without re-encrypting existing docs)
HR_DOC_ENC_KEY=change-me-64-hex-characters

# --- WORK ORDERS (dispatcher email intake; dormant until enabled) ---
WORK_ORDERS_ENABLED=false
# Shared mailbox that receives work-order emails (read via Microsoft Graph, below).
WORK_ORDERS_MAILBOX=workorders@popalockar.com
# User id that owns system-generated work-order records.
WORK_ORDERS_SYSTEM_USER_ID=
# Days to retain closed work orders before cleanup.
WORK_ORDER_RETENTION_DAYS=365

# --- MICROSOFT 365 GRAPH (mailbox ingest: GEICO + Work Orders) ---
# Entra app registration with application Mail.Read (plus others as needed).
MS_TENANT_ID=your-azure-tenant-id
MS_CLIENT_ID=your-graph-app-client-id
MS_CLIENT_SECRET=your-graph-app-client-secret

# --- GEICO REPORTING ---
# Mailbox the GEICO assignment emails land in, and who receives the digest.
GEICO_MAILBOX=geico@popalockar.com
GEICO_REPORT_RECIPIENTS=ops@popalockar.com, manager@popalockar.com

# --- REVIEWS DASHBOARD (external google-review-bot Postgres, read-only) ---
REVIEWS_DATABASE_URL=postgresql://user:password@host:port/dbname
# Optional PEM CA cert so TLS to that DB is fully verified. If omitted the connection
# still uses TLS but does not verify the server cert (encryption-only).
REVIEWS_DB_CA_CERT=

# --- INBOUND EMAIL WEBHOOKS (Resend) ---
# Shared secret Resend signs the email-to-task inbound webhook with.
RESEND_INBOUND_SECRET=your-inbound-webhook-secret
# Customer-feedback intake (Pulsar tech-conduct emails).
FEEDBACK_INBOUND_ADDRESS=feedback@in.popalockar.com
RESEND_FEEDBACK_SECRET=your-feedback-webhook-secret
# Optional model override for feedback classification (blank = default).
FEEDBACK_AI_MODEL=
# Accounts Payable intake. A staff member forwards a vendor bill here and Nova
# files a DRAFT payable for them to confirm. Uses the SAME /api/inbound/email
# webhook and RESEND_INBOUND_SECRET above (routed by recipient), so no extra
# secret is needed - just point this address's Resend route at the same webhook.
AP_INBOUND_ADDRESS=bills@in.popalockar.com

# --- MISC ---
# Bearer key protecting the external report API endpoint.
REPORT_API_KEY=your-report-api-key
# Fallback payroll recipient if the in-app Company Info payroll email is blank.
PAYROLL_EMAIL=payroll@popalockar.com
# Days to retain audit-log rows before cleanup.
AUDIT_RETENTION_DAYS=730

# ---- GoTo Connect (call recordings on customer complaints) ----
# Create an OAuth client at https://developer.goto.com (My Apps > Create a client).
# GoTo has NO client_credentials grant, so an admin must connect it once from
# Nova Settings; Nova then keeps the 30-day refresh token alive on its own.
GOTO_CLIENT_ID=
GOTO_CLIENT_SECRET=
# Must match the redirect URI registered on the GoTo OAuth client EXACTLY.
GOTO_REDIRECT_URI=https://your-nova-domain/api/goto/callback
# Your GoTo account key. Required for call lookups, not for connecting.
GOTO_ACCOUNT_KEY=
# Optional. Overrides the requested OAuth scopes without a code change -
# use this if the Recording API turns out to need a scope beyond the default
# "cr.v1.read call-events.v1.notifications.manage".
GOTO_SCOPES=
# Optional. 32-byte base64/hex key for encrypting stored GoTo tokens.
# Falls back to HR_DOC_ENC_KEY, then JWT_SECRET, so tokens are never plaintext.
GOTO_TOKEN_KEY=

# ===========================================================================
#  Variables the code reads that were previously undocumented here.
#  Check Railway before assuming any of these is unset — several are already
#  configured in production.
# ===========================================================================

# --- CORS (staged rollout — see server.js) ---
# Extra allowed origins, comma separated. APP_URL and Microsoft Office hosts are
# always allowed. Requests with NO Origin header are always allowed (webhooks,
# server-to-server, Railway health check).
CORS_ORIGINS=
# Leave OFF at first. While off, an unapproved origin is LOGGED (once per boot)
# and written to the audit log as 'cors_blocked' but still allowed. Watch the
# logs for a week, add anything legitimate to CORS_ORIGINS, then set true.
CORS_STRICT=false

# --- Content Security Policy (opt-in — see server.js) ---
# public/js/app.js carries hundreds of inline onclick handlers, so a CSP without
# 'unsafe-inline' would take the whole UI down. The opt-in policy keeps
# 'unsafe-inline' for scripts but pins where scripts, frames and form posts may go.
# Turn CSP_REPORT_ONLY on FIRST and read what it would have blocked.
CSP_ENABLED=false
CSP_REPORT_ONLY=false

# --- GEOCODING (dispatch addresses + coverage zones) ---
# Provider for utils/geocode.js. 'geocodio' today; 'google' is written but gated.
# NOTE: the cache TTL differs by provider because their LICENCES differ —
# Geocodio permits keeping coordinates indefinitely, Google allows 30 days and
# forbids displaying the result on a non-Google map.
GEOCODE_PROVIDER=geocodio
GEOCODIO_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- SQUARE (card payments, refunds, POS handoff) ---
# 'sandbox' switches to Square's sandbox API base; anything else is production.
SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
# HMAC secret used to sign the POS handoff state parameter. Required — Square
# support is considered unconfigured without ACCESS_TOKEN + APPLICATION_ID + this.
SQUARE_STATE_SECRET=
# Verifies the webhook signature (computed over the RAW body).
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Optional overrides. Defaults are derived from the request / APP_URL.
SQUARE_WEBHOOK_URL=
SQUARE_POS_CALLBACK_URL=
SQUARE_RETURN_BASE=
# Optional Square-Version header pin (blank = the SDK/API default).
SQUARE_API_VERSION=

# --- GOTO CONNECT (extras) ---
# Organisation id, when the account has more than one.
GOTO_ORG_ID=
# Secret embedded in the GoTo webhook path. Falls back to JWT_SECRET.
GOTO_WEBHOOK_SECRET=
# '1' keeps the raw call report for EVERY call, not just calls with a recording.
# Verbose; useful when diagnosing why a call did not match.
GOTO_KEEP_ALL_RAW=

# --- LOW-STAR REVIEW → COMPLAINT (jobs/reviewComplaints.js) ---
# Poll schedule (default every 2 minutes).
REVIEW_COMPLAINTS_CRON=*/2 * * * *
# Max star rating that files a complaint. CLAMPED 1-4: 0 would silently disable
# the job and 5 would file complaints about happy customers. Default 3.
REVIEW_COMPLAINT_MAX_RATING=3
# How far back a single poll looks.
REVIEW_COMPLAINTS_LOOKBACK_HOURS=
# IMPORTANT: the very first run only records a baseline watermark and files
# NOTHING, so years of old 1-stars are not back-filed. Set this (a date) BEFORE
# first boot if you want an earlier starting point.
REVIEW_COMPLAINTS_SINCE=
# Safety-net sweep. The cursor above deliberately advances past rows it failed on
# so one bad review cannot wedge the queue - which means a review that failed once
# is never retried. This sweep re-checks the last N days for any review at or below
# the threshold with NO complaint on file and files it. Default 14, clamped 0-90;
# 0 turns the net off. Settings key review_complaints_sweep_days wins over this.
REVIEW_COMPLAINTS_SWEEP_DAYS=

# --- RETENTION ---
# Days to keep security-event rows (utils/security.js).
SECURITY_RETENTION_DAYS=

# --- JUDI (MidTN Dispatch AI receptionist) ---
# Judi answers the inbound Pop-A-Lock line. Read-only API, key in X-API-Key.
# Without this key the Call Lookup page simply shows Nova calls only - it is
# not an error state. Get the key from William at MidTN Dispatch.
JUDI_API_KEY=
# Override only if MidTN moves the API. Default https://midtndispatch.com/api/v1
JUDI_API_BASE=
# The call list/detail path under the base. Exists as a knob because the path
# was captured by hand rather than from a published spec; GET /api/judi/status
# (admin) reports which paths actually answered. Default /calls
JUDI_PATH_CALLS=
# Per-request timeout in ms. Default 12000.
JUDI_TIMEOUT_MS=
# In-memory cache TTL in ms. Default 60000. Nova never writes Judi data to the
# database, so this cache is the ONLY place it lives, and briefly.
JUDI_CACHE_TTL_MS=
# Client-side rate cap. Default 100, deliberately under the documented 120/min
# so a burst of searches cannot walk into a 429 that would look like no calls.
JUDI_RATE_PER_MIN=
